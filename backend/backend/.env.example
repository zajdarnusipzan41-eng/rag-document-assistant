# --- FastAPI App Configuration ---
APP_NAME="RAG Document Assistant API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# --- CORS Settings (для React Frontend) ---
# Укажи URL, на котором крутится React (например, http://localhost:3000 или http://localhost:5173)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# --- AI & LLM API Keys ---
# Заполни тот ключ, который используешь в rag_engine.py
OPENAI_API_KEY="your_openai_api_key_here"
# GEMINI_API_KEY="your_gemini_api_key_here"
# HUGGINGFACEHUB_API_TOKEN="your_huggingface_token_here"

# --- ChromaDB Vector Store ---
# Путь для локального сохранения базы данных на диске
CHROMA_DB_DIR="./data/chroma_db"
# Имя коллекции по умолчанию
CHROMA_COLLECTION_NAME="documents"

# --- RAG Settings ---
# Модель для эмбеддингов и чанкинг
EMBEDDING_MODEL_NAME="text-embedding-3-small"
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4
