from unittest.mock import patch

@patch("rag_assistant.generate_answer")  # подменяем реальную функцию генерации
def test_answer_contains_context(mock_generate):
    mock_generate.return_value = "Согласно документу, нужно взять 200 г муки."
    
    chunks = ["В рецепте сказано: возьмите 200 г муки."]
    query = "сколько муки?"
    
    answer = generate_answer(query, chunks)  # твой код, который вызывает модель
    
    assert "мука" in answer.lower()
    assert "200" in answer
